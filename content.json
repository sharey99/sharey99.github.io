---
layout: null
---
[
{%- assign comma = "" -%}
{%- for group in site.data.cards -%}
 {%- assign tab = site.data.navigation[group[0]] -%}
 {%- if tab and tab.hidden != true -%}
  {%- for record in group[1] -%}
    {{- comma -}}{"category":{{ group[0] | jsonify }}
    {%- for field in record[1] -%}
      {%- unless field[0] == "category" -%},{{ field[0] | jsonify }}:{{ field[1] | jsonify }}{%- endunless -%}
    {%- endfor -%}}
    {%- assign comma = "," -%}
  {%- endfor -%}
{%- endif -%}
{%- endfor -%}
]
