---
layout: null
---
[
{%- assign comma = "" -%}
{%- for group in site.data.resources -%}
  {%- for record in group[1] -%}
    {{- comma -}}{"resourceType":{{ group[0] | jsonify }}
    {%- for field in record[1] -%}
      {%- unless field[0] == "resourceType" -%},{{ field[0] | jsonify }}:{{ field[1] | jsonify }}{%- endunless -%}
    {%- endfor -%}}
    {%- assign comma = "," -%}
  {%- endfor -%}
{%- endfor -%}
]
